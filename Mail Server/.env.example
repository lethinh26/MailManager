# ==============================================================================
# Cấu hình Môi trường cho Mail Server (Template .env)
# Sao chép tệp này thành .env hoặc .env.local và điền các giá trị thực tế.
# LƯU Ý BẢO MẬT: KHÔNG commit tệp .env hoặc .env.local chứa thông tin mật lên Git.
# ==============================================================================

# Cấu hình Mạng & Cổng
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8443
MYSQL_PORT=3306

# Cơ sở dữ liệu MySQL
MYSQL_DATABASE=mailapp_db
MYSQL_USER=mailapp
DB_PASSWORD=

# Khóa bảo mật hệ thống (Bắt buộc cho Production)
# JWT_SECRET: Chuỗi bí mật HMAC SHA-256 (độ dài >= 32 bytes / 256 bits)
JWT_SECRET=

# AES_KEY: Khóa mã hóa AES-256 đối xứng Base64 (đúng 32 bytes sau khi giải mã)
AES_KEY=

# KEYSTORE_PASSWORD: Mật khẩu bảo vệ SSL PKCS12 Keystore
KEYSTORE_PASSWORD=

# ADMIN_INITIAL_PASSWORD: Mật khẩu khởi tạo tài khoản ADMIN (bắt buộc đổi khi đăng nhập lần đầu)
ADMIN_INITIAL_PASSWORD=

# Google OAuth2 Credentials (dành cho module M06)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:8443/api/oauth2/callback
